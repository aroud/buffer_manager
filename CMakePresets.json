{
  "version": 5,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BUFFER_MANAGER_BUILD_BENCHMARKS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BUFFER_MANAGER_BUILD_BENCHMARKS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUFFER_MANAGER_BUILD_BENCHMARKS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tidy",
      "displayName": "Clang-Tidy",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BUFFER_MANAGER_BUILD_BENCHMARKS": "ON",
        "BUFFER_MANAGER_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Benchmarks",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUFFER_MANAGER_BUILD_BENCHMARKS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "targets": [
        "buffer_manager_benchmarks"
      ]
    },
    {
      "name": "format",
      "configurePreset": "debug",
      "targets": [
        "format"
      ]
    },
    {
      "name": "format-check",
      "configurePreset": "debug",
      "targets": [
        "format-check"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}